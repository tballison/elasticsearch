# Elasticsearch image — MUST be built from THIS branch first (has the tika-server backend + MockParser).
# Apple Silicon / aarch64:   ./gradlew :distribution:docker:buildAarch64DockerImage
# x86_64:                    ./gradlew :distribution:docker:buildDockerImage
# (run from the repo root; NOT ":distribution:docker:dockerBuild" — that task does not exist.)
# Builds + tags docker.elastic.co/elasticsearch/elasticsearch:<STACK_VERSION> into the local daemon.
ES_IMAGE=docker.elastic.co/elasticsearch/elasticsearch
STACK_VERSION=9.6.0-SNAPSHOT

# Apache Tika server base image (on Docker Hub). MockParser is added via the tests-jar mount in compose.
TIKA_VERSION=4.0.0-SNAPSHOT-full
